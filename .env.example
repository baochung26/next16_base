# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production-please-use-a-random-string

# Google OAuth (Optional - for Google login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API Configuration
# Set to true to use fake API (local Next.js routes), false to use real NestJS backend
NEXT_PUBLIC_USE_FAKE_API=true
# Backend API URL (only used when NEXT_PUBLIC_USE_FAKE_API=false)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
